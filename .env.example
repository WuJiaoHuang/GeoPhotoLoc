# Copy only when .env does not exist. Never commit .env or credentials.
GEOPHOTOLOC_VLM_API_KEY=
GEOPHOTOLOC_VLM_MODEL=qwen3.8-flash
GEOPHOTOLOC_VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Timeout in seconds per attempt; retries are bounded by the OpenAI SDK.
GEOPHOTOLOC_VLM_TIMEOUT=60
GEOPHOTOLOC_VLM_MAX_RETRIES=2
